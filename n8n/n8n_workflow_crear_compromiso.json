{
  "name": "PoC - POST Crear Compromiso",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "compromisos",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/app67VJvBnXq015CI/Plan_Desarrollo",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"fields\": { \"Persona\": [$json.body.persona_id], \"Skill_Gap\": $json.body.skill_ids, \"Titulo_Proyecto\": $json.body.titulo_proyecto, \"Accion_Recomendada\": $json.body.accion_recomendada, \"Responsable\": $json.body.responsable, \"Fecha_Compromiso\": $json.body.fecha_compromiso, \"Estado\": \"No iniciado\" } } }}",
        "options": {}
      },
      "id": "create",
      "name": "Create Compromiso",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_ID_CREDENCIAL",
          "name": "Airtable Token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'ok', id: $json.id } }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "POST, OPTIONS"
              }
            ]
          }
        }
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        640,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Create Compromiso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Compromiso": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}